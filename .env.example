UKG_ENVIRONMENT=development
# Use memory for isolated unit/dev runs or postgres for durable storage.
# Production configuration is rejected unless this is postgres.
UKG_STORAGE_BACKEND=postgres
UKG_API_KEY=
UKG_DATABASE_URL=postgresql+psycopg://ukg:ukg@postgres:5432/ukg
UKG_EMBEDDING_PROVIDER=local-hash
# PostgreSQL vector schema is currently versioned at 384 dimensions.
# Changing this for postgres requires a database migration.
UKG_EMBEDDING_DIMENSIONS=384
UKG_OPENAI_API_KEY=
UKG_MAX_CHUNK_CHARS=1600
UKG_CHUNK_OVERLAP_CHARS=200
UKG_LOG_LEVEL=INFO
